# WhatsApp Cloud API
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=v23.0

# Backend Bellidental
BACKEND_URL=http://localhost:8080
BOT_API_KEY=

# General
CLINIC_ZONE=America/Guayaquil
CONVERSATION_TTL_MINUTES=30

# LLM. Sin LLM_API_KEY el bot usa solo el menú. LLM_MODEL que empieza por "claude-" usa la API de Anthropic
# (LLM_BASE_URL no aplica); cualquier otro modelo usa un proveedor compatible con OpenAI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8

# Recordatorios (plantilla aprobada en Meta)
WA_REMINDER_TEMPLATE=recordatorio_cita
WA_TEMPLATE_LANGUAGE=es
REMINDER_INTERVAL_SECONDS=300
REMINDERS_ENABLED=true
